@'
# Python
__pycache__/
*.py[cod]
*.log

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Django local database
db.sqlite3
db.sqlite3-journal

# User uploaded files
media/

# IDE settings
.vscode/
.idea/

# Python tools cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Build files
build/
dist/
*.egg-info/

# Secret keys and certificates
*.pem
*.key
secrets.json
'@ | Set-Content -Encoding utf8 .gitignore